    if not State.SnowGui.Parent then State.SnowGui.Parent = lp:WaitForChild("PlayerGui") end
    local flakes = {}
    for i = 1, 80 do
        local f = Instance.new("Frame", State.SnowGui)
        f.Size = UDim2.new(0, math.random(8, 15), 0, math.random(8, 15))
        f.Position = UDim2.new(math.random(), 0, math.random(), 0)
        f.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        f.BackgroundTransparency = math.random(30, 60) / 100
        f.BorderSizePixel = 0
        Instance.new("UICorner", f).CornerRadius = UDim.new(0.5, 0)
        flakes[#flakes+1] = {f=f, x=math.random()*100, y=math.random()*100, sp=math.random()*3+2}
    end
    State.SnowConn = RunService.RenderStepped:Connect(function()
        if not State.SnowGui or not State.SnowGui.Parent then return end
        for _, fl in ipairs(flakes) do
            fl.y = fl.y + fl.sp / 100
            if fl.y > 105 then fl.y = -5; fl.x = math.random() * 100 end
            fl.f.Position = UDim2.new(fl.x / 100, 0, fl.y / 100, 0)
        end
    end)
end

