local function addHL(inst, color, name)
    if not inst or inst:FindFirstChild(name) then return end
    local h = Instance.new("Highlight")
    h.Name = name
    h.FillColor, h.OutlineColor = color, color
    h.FillTransparency, h.OutlineTransparency = 0.55, 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = inst
end
local function rmHL(inst, name)
    local h = inst and inst:FindFirstChild(name)
    if h then h:Destroy() end
end
