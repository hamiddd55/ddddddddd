local function makeTrail()
    if not State.Character then return end
    local root = State.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if root:FindFirstChild("NEXUS_Trail") then return end
    local a0 = Instance.new("Attachment", root)
    a0.Position = Vector3.new(0, 1, 0)
    local a1 = Instance.new("Attachment", root)
    a1.Position = Vector3.new(0, -1, 0)
    local t = Instance.new("Trail", root)
    t.Name = "NEXUS_Trail"
    t.Attachment0 = a0
    t.Attachment1 = a1
    t.Color = ColorSequence.new(Config.TrailColor)
    t.Lifetime = 1.6
    t.LightEmission = 0.2
    t.Brightness = 10
    t.WidthScale = NumberSequence.new{NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0)}
end

