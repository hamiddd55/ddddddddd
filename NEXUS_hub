local function toggle(par, lbl, key, o)
    local r = Instance.new("Frame", par)
    r.Size, r.BackgroundColor3, r.BorderSizePixel, r.LayoutOrder = UDim2.new(1,0,0,32), Color3.fromRGB(18,18,24), 0, o
    Instance.new("UICorner", r).CornerRadius = UDim.new(0,8)
    local l = Instance.new("TextLabel", r)
    l.Size, l.Position, l.BackgroundTransparency = UDim2.new(1,-70,1,0), UDim2.new(0,12,0,0), 1
    l.Text, l.TextColor3, l.Font, l.TextSize = lbl, Color3.fromRGB(210,210,220), Enum.Font.Gotham, 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    local sw = Instance.new("Frame", r)
    sw.Size, sw.Position, sw.BackgroundColor3, sw.BorderSizePixel = UDim2.new(0,40,0,20), UDim2.new(1,-52,0.5,-10), Color3.fromRGB(35,35,44), 0
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1,0)
    local k = Instance.new("Frame", sw)
    k.Size, k.Position, k.BackgroundColor3, k.BorderSizePixel = UDim2.new(0,14,0,14), UDim2.new(0,3,0.5,-7), Color3.fromRGB(200,200,210), 0
    Instance.new("UICorner", k).CornerRadius = UDim.new(1,0)
    local b = Instance.new("TextButton", r)
    b.Size, b.BackgroundTransparency, b.Text, b.ZIndex = UDim2.new(1,0,1,0), 1, "", 3
    local function refresh()
        if Config[key] then
            TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3=Config.Theme}):Play()
            TweenService:Create(k, TweenInfo.new(0.2), {Position=UDim2.new(1,-17,0.5,-7)}):Play()
        else
            TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3=Color3.fromRGB(35,35,44)}):Play()
            TweenService:Create(k, TweenInfo.new(0.2), {Position=UDim2.new(0,3,0.5,-7)}):Play()
        end
    end
    b.MouseButton1Click:Connect(function() Config[key] = not Config[key]; refresh() end)
    refresh()
end

local function slider(par, lbl, key, mn, mx, o)
    local r = Instance.new("Frame", par)
    r.Size, r.BackgroundColor3, r.BorderSizePixel, r.LayoutOrder = UDim2.new(1,0,0,46), Color3.fromRGB(18,18,24), 0, o
    Instance.new("UICorner", r).CornerRadius = UDim.new(0,8)
    local l = Instance.new("TextLabel", r)
    l.Size, l.Position, l.BackgroundTransparency = UDim2.new(1,-20,0,16), UDim2.new(0,12,0,4), 1
    l.Text, l.TextColor3, l.Font, l.TextSize = lbl, Color3.fromRGB(210,210,220), Enum.Font.GothamBold, 10
    l.TextXAlignment = Enum.TextXAlignment.Left
    local v = Instance.new("TextLabel", r)
    v.Size, v.Position, v.BackgroundTransparency = UDim2.new(1,-20,0,16), UDim2.new(0,12,0,4), 1
    v.Text, v.TextColor3, v.Font, v.TextSize = tostring(Config[key]), Config.Theme, Enum.Font.GothamBold, 10
    v.TextXAlignment = Enum.TextXAlignment.Right
    local bg = Instance.new("Frame", r)
    bg.Size, bg.Position, bg.BackgroundColor3, bg.BorderSizePixel = UDim2.new(1,-24,0,4), UDim2.new(0,12,1,-16), Color3.fromRGB(35,35,44), 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1,0)
    local f = Instance.new("Frame", bg)
    f.Size, f.BackgroundColor3, f.BorderSizePixel = UDim2.new(0,0,1,0), Config.Theme, 0
    Instance.new("UICorner", f).CornerRadius = UDim.new(1,0)
    local kn = Instance.new("Frame", bg)
    kn.Size, kn.Position, kn.BackgroundColor3, kn.BorderSizePixel = UDim2.new(0,12,0,12), UDim2.new(0,-6,0.5,-6), Color3.fromRGB(255,255,255), 0
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1,0)
    local function setV(val)
        val = math.clamp(val, mn, mx)
        Config[key] = val
        local pct = (val - mn) / (mx - mn)
        f.Size = UDim2.new(pct, 0, 1, 0)
        kn.Position = UDim2.new(pct, -6, 0.5, -6)
        v.Text = tostring(math.floor(val * 100) / 100)
    end
    setV(Config[key])
    local drag = false
    local function fromInput(i)
        local rel = (i.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X
        setV(mn + math.clamp(rel, 0, 1) * (mx - mn))
    end
    bg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; fromInput(i)
        end
    end)
    kn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = true end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromInput(i) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

