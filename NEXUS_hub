local function makePage(n)
    local p = Instance.new("ScrollingFrame", PC)
    p.Name, p.Size, p.BackgroundTransparency, p.BorderSizePixel = n, UDim2.new(1,0,1,0), 1, 0
    p.ScrollBarThickness, p.ScrollBarImageColor3 = 3, Config.Theme
    p.CanvasSize, p.AutomaticCanvasSize = UDim2.new(0,0,0,0), Enum.AutomaticSize.Y
    p.Visible = false
    local l = Instance.new("UIListLayout", p)
    l.Padding, l.SortOrder = UDim.new(0,6), Enum.SortOrder.LayoutOrder
    local u = Instance.new("UIPadding", p)
    u.PaddingRight, u.PaddingBottom = UDim.new(0,6), UDim.new(0,12)
    return p
end

local function makeTab(n, o)
    local b = Instance.new("TextButton", TabBar)
    b.Size, b.AutomaticSize = UDim2.new(0,0,0,24), Enum.AutomaticSize.X
    b.BackgroundColor3, b.Text, b.TextColor3 = Color3.fromRGB(28,28,36), n, Color3.fromRGB(180,180,190)
    b.Font, b.TextSize, b.LayoutOrder = Enum.Font.GothamBold, 10, o
    local p = Instance.new("UIPadding", b)
    p.PaddingLeft, p.PaddingRight = UDim.new(0,10), UDim.new(0,10)
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
    local pg = makePage(n)
    Pages[n], TabButtons[n] = pg, b
    b.MouseButton1Click:Connect(function()
        for nn, pp in pairs(Pages) do pp.Visible = (nn == n) end
        for nn, bb in pairs(TabButtons) do
            if nn == n then
                TweenService:Create(bb, TweenInfo.new(0.2), {BackgroundColor3=Config.Theme, TextColor3=Color3.fromRGB(10,10,15)}):Play()
            else
                TweenService:Create(bb, TweenInfo.new(0.2), {BackgroundColor3=Color3.fromRGB(28,28,36), TextColor3=Color3.fromRGB(180,180,190)}):Play()
            end
        end
    end)
end

